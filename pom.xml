<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pro.mir0n</groupId>
    <artifactId>herald-parent</artifactId>
<!--xxx: we need a stable parent version to be referenced correctly -->
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <name>Herald</name>
    <organization>
        <name>mir0n.pro</name>
    </organization>
    <url/>

    <description>
        Herald Messaging Framework: the bus that carries word between services and keeps the roll of who
        is on it. messaging is the framework (catalog, x-rod engine, transport SPI, codec); tp-* are the
        transport providers, one per vendor; dataKeep is the keep library that stores what the bus relays.
        No Esquire inside -- it sits on Armoury and under any domain.
    </description>

    <modules>
        <module>messaging</module>
        <module>dataKeep</module>
        <module>tp-activemq</module>
        <module>tp-redis</module>
        <module>tp-kafka</module>
        <module>tp-sqns</module>
        <module>tp-kinesis</module>
    </modules>

    <properties>
        <version-qualifier></version-qualifier>
        <timestamp>${maven.build.timestamp}</timestamp>
        <maven.build.timestamp.format>yyMM.ddHH</maven.build.timestamp.format>
        <!-- build properties -->
        <java.version>24</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- versions of modules -->
<!--
  The idea :
   Herald is a single Product but it has a set of projects.
   They might have their own versioning
-->
        <herald.version>2.0.1</herald.version>
        <messaging.version>${herald.version}</messaging.version>
        <dataKeep.version>${herald.version}</dataKeep.version>
        <tp.version>${herald.version}</tp.version>

        <!-- Armoury sits upstream: utils is the bottom of the stack, and carries the meter / trace
             facades under pro.mir0n.o11y. -->
        <armoury.version>2.0.0</armoury.version>

        <!-- library versions -->
        <spring-boot.version>3.5.9</spring-boot.version>
        <aws-sdk.version>2.54.6</aws-sdk.version>
        <jackson.version>2.18.2</jackson.version>

        <!-- plugin versions -->
        <maven.compiler.version>3.13.0</maven.compiler.version>
        <maven.jar.version>3.4.2</maven.jar.version>
        <maven.resources.version>3.3.1</maven.resources.version>
        <maven.dependency.version>3.7.0</maven.dependency.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>
        <maven.deploy.version>3.1.4</maven.deploy.version>
        <flatten.version>1.7.3</flatten.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Armoury. Pinned here so no project states a version of it. -->
            <dependency>
                <groupId>pro.mir0n</groupId>
                <artifactId>armoury-utils</artifactId>
                <version>${armoury.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.version}</version>
                </plugin>

                <!-- Only the AWS transport providers use it: they copy their runtime tail into
                     target/aws-lib, which a deployment attaches instead of building it into an image. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>
            <!--xxx: the parent stays at its own version while the projects move on herald.version, so a
                published pom must not need it: flatten writes the real versions in and drops the parent -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.version}</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--xxx: the parent is not published: the registry takes its version only once -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Code coverage: prepare-agent instruments the forked test JVM (surefire), so every test that
                 runs in it is measured: the unit tests and the in-JVM Testcontainers / @SpringBootTest
                 ones alike. One report per project at target/site/jacoco/index.html. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--xxx: GitHub Packages needs a token even for a public package; the ids match the <server>
        entries in the settings the CI writes. A local build finds the jars in ~/.m2 first -->
    <repositories>
        <repository>
            <id>armoury</id>
            <url>https://maven.pkg.github.com/mir0n-pro/armoury</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!--xxx: GitHub Packages: the id must match a <server> in the settings the publish workflow writes -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/mir0n-pro/herald</url>
        </repository>
    </distributionManagement>

</project>
