<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pro.mir0n</groupId>
        <artifactId>herald-parent</artifactId>
<!--xxx: we need a stable parent version to be referenced correctly -->
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>herald-tp-activemq</artifactId>
    <version>${tp.version}</version>

    <name>tp-activemq</name>
    <description>Transport provider (tp) -- ActiveMQ. Generic publish/consume over the transport seam.</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>pro.mir0n</groupId>
            <artifactId>herald-messaging</artifactId>
            <version>${messaging.version}</version>
        </dependency>

        <!-- ActiveMQ client + spring-jms (JmsTemplate, DefaultMessageListenerContainer) + autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
        </dependency>

        <!-- test only: an embedded ActiveMQ broker, so the broker-enforced noLocal own-exclusion is verified
             for real (a shared-connection consumer does NOT get its own publications; a separate one does). -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-broker</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- test only: SimpleAuthenticationPlugin lives in activemq-broker but its principals come from here,
             so an embedded broker that DEMANDS a user and a password does not start without it. -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-jaas</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
